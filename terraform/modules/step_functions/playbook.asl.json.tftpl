{
  "Comment": "Argus ${playbook} playbook: Validate -> RecordIncident -> Preserve -> Contain -> Eradicate -> Package -> Finalize -> Notify -> (wait) -> CollectLateEvidence",
  "StartAt": "ValidateFinding",
  "States": {
    "ValidateFinding": {
      "Type": "Task",
      "Resource": "${validator_arn}",
      "Parameters": {
        "playbook": "${playbook}",
        "finding.$": "$"
      },
      "ResultSelector": {
        "envelope.$": "$"
      },
      "ResultPath": "$",
      "TimeoutSeconds": 30,
      "Retry": [${lambda_retry}],
      "Next": "RecordIncident"
    },

    "RecordIncident": {
      "Type": "Task",
      "Comment": "Atomic idempotency guard: the check and the write are one conditional PutItem.",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Item": {
          "finding_id": {"S.$": "$.envelope.occurrence_id"},
          "incident_key": {"S.$": "$.envelope.incident_key"},
          "security_hub_finding_id": {"S.$": "$.envelope.finding_id"},
          "finding_updated": {"S.$": "$.envelope.finding_updated"},
          "status": {"S": "IN_PROGRESS"},
          "playbook": {"S": "${playbook}"},
          "finding_type": {"S.$": "$.envelope.finding_type"},
          "severity": {"S.$": "$.envelope.severity"},
          "target_arn": {"S.$": "$.envelope.target.arn"},
          "started_at": {"S.$": "$$.State.EnteredTime"},
          "execution_arn": {"S.$": "$$.Execution.Id"}
        },
        "ConditionExpression": "attribute_not_exists(finding_id) OR #s = :failed",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {":failed": {"S": "FAILED"}}
      },
      "ResultPath": null,
      "TimeoutSeconds": 20,
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException", "DynamoDB.ThrottlingException", "DynamoDB.InternalServerErrorException"],
          "IntervalSeconds": 1,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": null,
          "Next": "AlreadyHandled"
        }
      ],
      "Next": "LockResource"
    },

    "AlreadyHandled": {
      "Type": "Succeed",
      "Comment": "Another execution already handled (or is handling) this finding."
    },

    "LockResource": {
      "Type": "Task",
      "Comment": "Per-resource guard: different findings about the same resource (GuardDuty raises one per mining domain) must not run concurrent playbooks against it.",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Item": {
          "finding_id": {"S.$": "$.envelope.resource_lock.key"},
          "owner_finding_id": {"S.$": "$.envelope.occurrence_id"},
          "owner_incident_key": {"S.$": "$.envelope.incident_key"},
          "lock_until": {"S.$": "$.envelope.resource_lock.until"},
          "locked_at": {"S.$": "$$.State.EnteredTime"}
        },
        "ConditionExpression": "attribute_not_exists(finding_id) OR lock_until < :now OR owner_finding_id = :me",
        "ExpressionAttributeValues": {
          ":now": {"S.$": "$$.State.EnteredTime"},
          ":me": {"S.$": "$.envelope.occurrence_id"}
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 20,
      "Retry": [
        {
          "ErrorEquals": ["DynamoDB.ProvisionedThroughputExceededException", "DynamoDB.ThrottlingException", "DynamoDB.InternalServerErrorException"],
          "IntervalSeconds": 1,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["DynamoDB.ConditionalCheckFailedException"],
          "ResultPath": null,
          "Next": "MarkDuplicate"
        }
      ],
      "Next": "PreserveEvidence"
    },

    "MarkDuplicate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Key": {
          "finding_id": {"S.$": "$.envelope.occurrence_id"}
        },
        "UpdateExpression": "SET #s = :dup, completed_at = :t, duplicate_of = :lock",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {
          ":dup": {"S": "DUPLICATE"},
          ":t": {"S.$": "$$.State.EnteredTime"},
          ":lock": {"S.$": "$.envelope.resource_lock.key"}
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 20,
      "Next": "ResolveDuplicateFinding"
    },

    "ResolveDuplicateFinding": {
      "Type": "Task",
      "Comment": "Close the duplicate in Security Hub too, pointing at the incident that holds the resource. Best effort.",
      "Resource": "arn:aws:states:::aws-sdk:securityhub:batchUpdateFindings",
      "Parameters": {
        "FindingIdentifiers": [
          {
            "Id.$": "$.envelope.finding_id",
            "ProductArn.$": "$.envelope.product_arn"
          }
        ],
        "Workflow": {"Status": "RESOLVED"},
        "Note": {
          "Text.$": "States.Format('Duplicate: another Argus incident already contained {}', $.envelope.target.arn)",
          "UpdatedBy": "argus-soar"
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 20,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "DuplicateHasOtherActor"
        }
      ],
      "Next": "DuplicateHasOtherActor"
    },

    "DuplicateHasOtherActor": {
      "Type": "Choice",
      "Comment": "S3 only: the bucket is already handled, but this finding may name a different attacker credential.",
      "Choices": [
        {
          "And": [
            {"Variable": "$.envelope.playbook", "StringEquals": "s3"},
            {"Variable": "$.envelope.actor.user_name", "IsPresent": true}
          ],
          "Next": "ChainActor"
        }
      ],
      "Default": "DuplicateForResource"
    },

    "ChainActor": {
      "Type": "Task",
      "Comment": "Start the IAM playbook for the actor; its own resource lock prevents double containment.",
      "Resource": "${playbook_arn}",
      "Parameters": {
        "phase": "chain_actor",
        "envelope.$": "$.envelope"
      },
      "ResultPath": "$.chain",
      "TimeoutSeconds": 30,
      "Retry": [${lambda_retry}],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.chain_error",
          "Next": "DuplicateForResource"
        }
      ],
      "Next": "DuplicateForResource"
    },

    "DuplicateForResource": {
      "Type": "Succeed",
      "Comment": "Another incident already holds this resource; this finding is recorded as a duplicate."
    },

    "PreserveEvidence": {
      "Type": "Task",
      "Resource": "${forensics_arn}",
      "Parameters": {
        "envelope.$": "$.envelope"
      },
      "ResultPath": "$.evidence",
      "TimeoutSeconds": 150,
      "Retry": [${lambda_retry}],
      "Catch": [${catch_to_failed}],
      "Next": "Contain"
    },

    "Contain": {
      "Type": "Task",
      "Resource": "${playbook_arn}",
      "Parameters": {
        "phase": "contain",
        "envelope.$": "$.envelope",
        "evidence.$": "$.evidence"
      },
      "ResultPath": "$.containment",
      "TimeoutSeconds": 90,
      "Retry": [${lambda_retry}],
      "Catch": [${catch_to_failed}],
      "Next": "Eradicate"
    },

    "Eradicate": {
      "Type": "Task",
      "Resource": "${playbook_arn}",
      "Parameters": {
        "phase": "eradicate",
        "envelope.$": "$.envelope",
        "evidence.$": "$.evidence"
      },
      "ResultPath": "$.eradication",
      "TimeoutSeconds": 90,
      "Retry": [${lambda_retry}],
      "Catch": [${catch_to_failed}],
      "Next": "PackageEvidence"
    },

    "PackageEvidence": {
      "Type": "Task",
      "Resource": "${package_arn}",
      "Parameters": {
        "state.$": "$"
      },
      "ResultPath": "$.package",
      "TimeoutSeconds": 60,
      "Retry": [${lambda_retry}],
      "Catch": [${catch_to_failed}],
      "Next": "Finalize"
    },

    "Finalize": {
      "Type": "Task",
      "Resource": "${finalize_arn}",
      "Parameters": {
        "state.$": "$"
      },
      "ResultPath": "$.finalize",
      "TimeoutSeconds": 30,
      "Retry": [${lambda_retry}],
      "Catch": [${catch_to_failed}],
      "Next": "Notify"
    },

    "Notify": {
      "Type": "Task",
      "Resource": "${notifier_arn}",
      "Parameters": {
        "mode": "success",
        "execution_arn.$": "$$.Execution.Id",
        "state.$": "$"
      },
      "ResultPath": "$.notify",
      "TimeoutSeconds": 30,
      "Retry": [${lambda_retry}],
      "Catch": [${catch_to_failed}],
      "Next": "WaitForLateLogs"
    },

    "WaitForLateLogs": {
      "Type": "Wait",
      "Comment": "CloudTrail (5-15 min) and Flow Logs (~10 min) arrive late.",
      "Seconds": ${late_evidence_wait_seconds},
      "Next": "CollectLateEvidence"
    },

    "CollectLateEvidence": {
      "Type": "Task",
      "Resource": "${late_evidence_arn}",
      "Parameters": {
        "state.$": "$"
      },
      "ResultPath": "$.late",
      "TimeoutSeconds": 330,
      "Retry": [${lambda_retry}],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.late_error",
          "Next": "NotifyLateEvidenceFailure"
        }
      ],
      "Next": "Done"
    },

    "NotifyLateEvidenceFailure": {
      "Type": "Task",
      "Comment": "The incident is contained; only the supplemental evidence is missing.",
      "Resource": "${notifier_arn}",
      "Parameters": {
        "mode": "warning",
        "execution_arn.$": "$$.Execution.Id",
        "state.$": "$"
      },
      "ResultPath": null,
      "TimeoutSeconds": 30,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "Done"
        }
      ],
      "Next": "Done"
    },

    "Done": {
      "Type": "Succeed"
    },

    "MarkFailed": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Key": {
          "finding_id": {"S.$": "$.envelope.occurrence_id"}
        },
        "UpdateExpression": "SET #s = :failed, failed_at = :t, error_name = :e, error_cause = :c",
        "ExpressionAttributeNames": {"#s": "status"},
        "ExpressionAttributeValues": {
          ":failed": {"S": "FAILED"},
          ":t": {"S.$": "$$.State.EnteredTime"},
          ":e": {"S.$": "$.error.Error"},
          ":c": {"S.$": "$.error.Cause"}
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 20,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 1,
          "BackoffRate": 2,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.mark_failed_error",
          "Next": "ReleaseLock"
        }
      ],
      "Next": "ReleaseLock"
    },

    "ReleaseLock": {
      "Type": "Task",
      "Comment": "Free the resource so a retry of this (FAILED) incident, or a new finding, can act on it.",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Parameters": {
        "TableName": "${table_name}",
        "Key": {
          "finding_id": {"S.$": "$.envelope.resource_lock.key"}
        },
        "ConditionExpression": "owner_finding_id = :me",
        "ExpressionAttributeValues": {
          ":me": {"S.$": "$.envelope.occurrence_id"}
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 20,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "NotifyFailure"
        }
      ],
      "Next": "NotifyFailure"
    },

    "NotifyFailure": {
      "Type": "Task",
      "Resource": "${notifier_arn}",
      "Parameters": {
        "mode": "failure",
        "execution_arn.$": "$$.Execution.Id",
        "state.$": "$"
      },
      "ResultPath": null,
      "TimeoutSeconds": 30,
      "Retry": [${lambda_retry}],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": null,
          "Next": "RemediationFailed"
        }
      ],
      "Next": "RemediationFailed"
    },

    "RemediationFailed": {
      "Type": "Fail",
      "Error": "ArgusRemediationFailed",
      "Cause": "A playbook phase failed; see the incident record in DynamoDB and the failure alert."
    }
  }
}
